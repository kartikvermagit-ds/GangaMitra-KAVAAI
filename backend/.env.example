# ==============================================
# GangaMitra Backend Environment Configuration
# ==============================================

# Server Configuration
PORT=5000
NODE_ENV=development

# CORS Configuration (comma-separated origins or * for development)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Supabase Credentials (from Supabase Project Settings -> API)
# IMPORTANT: Use the SERVICE_ROLE_KEY on the backend to allow database operations.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# AI Provider Configuration
# Supported providers: "gemini", "groq", "mock" (fallback when keys are absent)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Optional Groq Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
